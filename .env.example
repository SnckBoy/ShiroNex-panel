# ShiroNex Panel example configuration
# Copy this file to .env and replace every secret placeholder before production use.

NODE_ENV=production
HOST=0.0.0.0
PORT=6767

# Generate strong random values. Never commit the real values.
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_AUTH_SECRET=replace-with-a-strong-node-bootstrap-secret
NODE_ENCRYPTION_KEY=replace-with-a-strong-encryption-key

# Optional runtime settings
SFTP_PORT=6868
NODE_REQUEST_TIMEOUT_MS=10000
NODE_HEARTBEAT_TIMEOUT_MS=45000
DOCKER_SOCKET_PATH=/var/run/docker.sock
DEV_AUTO_LOGIN=false

# Optional HTTPS certificate paths. Leave empty for HTTP.
PANEL_TLS_KEY=
PANEL_TLS_CERT=

# Optional development-only CORS configuration, if supported by deployment tooling.
# CORS_ORIGIN=

# Keep this file free of passwords, API keys, Cloudflare tokens, node credentials,
# private keys, and production database values.
