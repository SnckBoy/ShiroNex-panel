FROM node:22-bookworm

WORKDIR /workspace/shironex

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=6767
EXPOSE 6767

CMD ["npm", "run", "dev"]

# The container expects the repository to be mounted at /workspace/shironex
# in Codespaces/CodeSandbox so source edits are immediately reflected.

EXPOSE 6768
EXPOSE 5173
