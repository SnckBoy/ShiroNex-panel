{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/components/**/*",
    "src/context/**/*",
    "src/hooks/**/*",
    "src/pages/**/*",
    "src/server/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/vite-env.d.ts",
    "server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}